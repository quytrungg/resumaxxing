# Copy to .env and fill in. backend/.env is git-ignored.
DATABASE_URL=postgresql+psycopg2://localhost:5432/resumaxxing

# Required-ish: encrypts stored API keys. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes previously stored keys undecryptable.
SECRET_KEY=change-me-to-a-long-random-string

# Optional single-password gate. Leave empty for local-only use.
APP_PASSWORD=

# JD URL scrape guards (bytes / seconds).
SCRAPE_MAX_BYTES=2000000
SCRAPE_TIMEOUT=15
